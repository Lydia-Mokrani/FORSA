datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CUSTOMER
  MERCHANT
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum ShopStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum DocumentType {
  COMMERCIAL_REGISTER
  TAX_ID
  STOREFRONT
}

enum DocumentStatus {
  SUBMITTED
  VALIDATED
  REJECTED
}

enum EmailTokenType {
  VERIFY_EMAIL
  RESET_PASSWORD
}

enum SocialProvider {
  GOOGLE
  APPLE
}

model User {
  id             String          @id @default(uuid())
  email          String          @unique
  passwordHash   String?
  fullName       String
  phone          String?         @unique
  avatarUrl      String?
  role           Role            @default(CUSTOMER)
  emailVerified  Boolean         @default(false)
  phoneVerified  Boolean         @default(false)
  status         UserStatus      @default(ACTIVE)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  shop           Shop?
  refreshTokens  RefreshToken[]
  phoneOtps      PhoneOtp[]
  emailTokens    EmailToken[]
  socialAccounts SocialAccount[]

  @@map("users")
}

model PhoneOtp {
  id        String   @id @default(uuid())
  userId    String
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("phone_otps")
}

model EmailToken {
  id        String         @id @default(uuid())
  userId    String
  type      EmailTokenType
  tokenHash String         @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime       @default(now())

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("email_tokens")
}

model SocialAccount {
  id             String         @id @default(uuid())
  provider       SocialProvider
  providerUserId String
  userId         String
  createdAt      DateTime       @default(now())

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("social_accounts")
}

model Shop {
  id               String         @id @default(uuid())
  userId           String         @unique
  name             String
  description      String?
  address          String
  latitude         Float
  longitude        Float
  phone            String
  openingHours     Json?
  logoUrl          String?
  status           ShopStatus     @default(PENDING)
  suspensionReason String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents        ShopDocument[]

  @@index([latitude, longitude])
  @@map("shops")
}

model ShopDocument {
  id           String         @id @default(uuid())
  shopId       String
  type         DocumentType
  filename     String
  originalName String
  mimeType     String
  size         Int
  fileUrl      String
  status       DocumentStatus @default(SUBMITTED)
  createdAt    DateTime       @default(now())

  shop         Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId])
  @@map("shop_documents")
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  revoked   Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}
