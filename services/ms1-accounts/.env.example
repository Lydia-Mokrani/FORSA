# Environnement MS1: Accounts & Shops
PORT=3001
NODE_ENV=development

# Base de données PostgreSQL dédiée (S1)
DATABASE_URL=postgresql://forsa_user:forsa_secret_ms1@localhost:5432/forsa_ms1_accounts?schema=public

# Clés asymétriques RSA 2048 (RS256)
JWT_PRIVATE_KEY_PATH=keys/private.pem
JWT_PUBLIC_KEY_PATH=keys/public.pem
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Bus d'événements RabbitMQ (S0)
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Service Discovery Consul (S0)
CONSUL_HOST=localhost
CONSUL_PORT=8500
SERVICE_HOST=localhost

# Sécurité interne inter-services
INTERNAL_API_KEY=forsa-internal-secret-token-2026

# Stockage privé des justificatifs commerçants (Volume Docker sécurisé)
UPLOAD_DIR=./uploads/documents
