# Environnement MS1: Accounts & Shops
PORT=3001
NODE_ENV=development

# Base de données PostgreSQL dédiée (S1)
DATABASE_URL=postgresql://forsa_user:forsa_secret_ms1@localhost:5432/forsa_ms1_accounts?schema=public

# Clés asymétriques RSA 2048 (RS256)
JWT_PRIVATE_KEY_PATH=keys/private.pem
JWT_PUBLIC_KEY_PATH=keys/public.pem
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Bus d'événements RabbitMQ (S0)
RABBITMQ_URL=amqp://forsa_user:forsa_password@10.0.0.10:5672

# Service Discovery Consul (S0)
CONSUL_HOST=10.0.0.10
CONSUL_PORT=8500
SERVICE_HOST=10.0.0.11

# Sécurité interne inter-services (Clé partagée 32-byte hex obligatoire sans fallback)
INTERNAL_API_KEY=0860c84a8ea7aaca109f98b5b30ce65a262d67425aad0f474290c3f3e86822f9

# Stockage privé des justificatifs commerçants (Volume Docker sécurisé)
UPLOAD_DIR=./uploads/documents

# Google OAuth 2.0 (Client ID obtenu sur Google Cloud Console)
GOOGLE_CLIENT_ID=

# Fournisseur SMS : 'log' (affiche dans la console en dev/soutenance) | 'twilio' (production)
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_VERIFY_SERVICE_SID=

# Telegram OTP Bot (Envoi instantané sécurisé sur smartphone)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=forsa_auth_bot

# Répertoire de stockage des photos de profil (avatars)
AVATAR_DIR=./uploads/avatars
