
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ReservationStatus {
  PENDING
  ACCEPTED
  REFUSED
  PICKED_UP
  CANCELLED
  EXPIRED
}

model Reservation {
  id            String            @id @default(uuid())
  customerId    String
  customerEmail String
  customerName  String?
  shopId        String
  offerId       String

  quantity      Int
  totalPrice    Decimal           @db.Decimal(10, 2)

  status        ReservationStatus @default(PENDING)

  pickupCode    String            @unique
  qrCodeData    String?           @db.Text

  pickupStart   DateTime
  pickupEnd     DateTime

  acceptedAt    DateTime?
  refusedAt     DateTime?
  cancelledAt   DateTime?
  pickedUpAt    DateTime?
  expiredAt     DateTime?

  refusalReason String?
  cancelReason  String?

  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  statusHistory ReservationStatusHistory[]

  @@index([customerId, createdAt])
  @@index([shopId, status])
  @@index([offerId])
  @@index([status, pickupEnd])
  @@map("reservations")
}

model ReservationStatusHistory {
  id            String            @id @default(uuid())
  reservationId String
  fromStatus    ReservationStatus?
  toStatus      ReservationStatus
  reason        String?
  actorId       String?
  actorRole     String?
  createdAt     DateTime          @default(now())

  reservation  Reservation       @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@index([reservationId, createdAt])
  @@map("reservation_status_history")
}

model CustomerNoShow {
  id             String   @id @default(uuid())
  customerId     String   @unique
  totalNoShows   Int      @default(0)
  lastNoShowAt   DateTime?
  blockedUntil   DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("customer_no_shows")
}
