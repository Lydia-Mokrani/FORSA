# ==============================================================================
# FORSA — MS5 Notifications & Telegram Bot Service
# ==============================================================================

NODE_ENV=development
PORT=3005
INSTANCE_ID=ms5-notifications-1

# Bot Telegram officiel (Singleton)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_BOT_USERNAME=forsa_auth_bot

# Bus d'événements RabbitMQ
EVENT_BUS_DRIVER=rabbitmq
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_EXCHANGE=forsa.events
OTP_TTL_SECONDS=300

# Découverte Consul (Interne, sans tags Traefik publics)
CONSUL_HOST=127.0.0.1
CONSUL_PORT=8500
SERVICE_HOST=127.0.0.1
SERVICE_PORT=3005

# Lot E1 : Expéditeur E-mail (SMTP agnostique ou log-masked)
EMAIL_DRIVER=log-masked
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=secret_app_password
MAIL_FROM=FORSA <no-reply@forsa.dz>
EMAIL_VERIFY_TTL_SECONDS=600
EMAIL_RECOVERY_TTL_SECONDS=900
