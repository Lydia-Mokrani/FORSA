// MS2 Catalogue & Search — Prisma Schema
// Database: ms2_catalogue (PostgreSQL)
// Owned exclusively by MS2 — no other service may connect to this database

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// CATEGORIES
// ─────────────────────────────────────────────────────────────────────────────

model Category {
  id         String   @id @default(uuid())
  slug       String   @unique
  name_fr    String
  name_ar    String
  icon       String?
  sort_order Int      @default(0)
  created_at DateTime @default(now())

  offers Offer[]

  @@map("categories")
}

// ─────────────────────────────────────────────────────────────────────────────
// SHOP SNAPSHOTS
// Read-only local copy of shop information received from MS1 through RabbitMQ.
// ─────────────────────────────────────────────────────────────────────────────

model ShopSnapshot {
  id             String     @id
  name           String
  address        String
  latitude       Float
  longitude      Float
  status         ShopStatus @default(ACTIVE)
  average_rating Float      @default(0)
  sales_count    Int        @default(0)
  merchant_id    String
  updated_at     DateTime   @updatedAt

  offers Offer[]

  @@map("shop_snapshots")
}

enum ShopStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

// ─────────────────────────────────────────────────────────────────────────────
// OFFERS
// ─────────────────────────────────────────────────────────────────────────────

model Offer {
  id          String @id @default(uuid())
  merchant_id String
  shop_id     String
  category_id String

  // Product information
  name             String
  description      String      @db.Text
  product_type     ProductType
  same_day_expiry  Boolean     @default(false)
  original_price   Decimal     @db.Decimal(10, 2)
  discounted_price Decimal     @db.Decimal(10, 2)
  discount_percent Int

  // Stock
  quantity_available Int @default(1)
  quantity_initial   Int

  // Dates
  expires_at          DateTime
  product_expiry_date DateTime

  // Status & Verification tracking
  status                OfferStatus  @default(DRAFT)
  previous_status       OfferStatus? // preserved during merchant suspension so reactivation restores correctly
  date_photo_url        String?
  verification_event_id String?
  rejection_reason      String?

  // Timestamps
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt
  published_at DateTime?
  expired_at   DateTime?

  // Relations
  category        Category        @relation(fields: [category_id], references: [id])
  shop            ShopSnapshot    @relation(fields: [shop_id], references: [id])
  photos          OfferPhoto[]
  stock_movements StockMovement[]

  // Indexes
  @@index([status])
  @@index([merchant_id])
  @@index([shop_id])
  @@index([category_id])
  @@index([expires_at])
  @@index([discounted_price])
  @@index([discount_percent])
  @@index([product_type])
  @@index([same_day_expiry])
  @@map("offers")
}

enum ProductType {
  PACKAGED
  FRESH
}

enum OfferStatus {
  DRAFT
  PENDING_VERIFICATION
  ACTIVE
  EXPIRED
  SOLD_OUT
  REJECTED
  HIDDEN
  WITHDRAWN
}

// ─────────────────────────────────────────────────────────────────────────────
// OFFER PHOTOS
// ─────────────────────────────────────────────────────────────────────────────

model OfferPhoto {
  id         String   @id @default(uuid())
  offer_id   String
  url        String
  filename   String
  size_bytes Int
  mime_type  String
  sort_order Int      @default(0)
  created_at DateTime @default(now())

  offer Offer @relation(fields: [offer_id], references: [id], onDelete: Cascade)

  @@index([offer_id])
  @@map("offer_photos")
}

// ─────────────────────────────────────────────────────────────────────────────
// STOCK MOVEMENTS
// Records reservations, releases, adjustments and pickups.
// ─────────────────────────────────────────────────────────────────────────────

model StockMovement {
  id             String       @id @default(uuid())
  offer_id       String
  reservation_id String?
  movement_type  MovementType
  quantity       Int
  reason         String?
  created_at     DateTime     @default(now())

  offer Offer @relation(fields: [offer_id], references: [id])

  // CRITICAL: Prevent duplicate reserve, release, or pickup for the same reservation
  @@unique([reservation_id, movement_type])
  @@index([offer_id])
  @@index([reservation_id])
  @@index([movement_type])
  @@map("stock_movements")
}

enum MovementType {
  RESERVE
  RELEASE
  ADJUSTMENT
  PICKUP
}
