# ─── Application ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3002
SERVICE_NAME=ms2-catalogue

# ─── Database ─────────────────────────────────────────────────────────────────
# MS2 owns its own PostgreSQL database — never connect to another service's DB
DATABASE_URL=postgresql://ms2_user:ms2_password@localhost:5433/ms2_catalogue

# ─── Authentication ───────────────────────────────────────────────────────────
# RS256 public key from MS1 — used to verify JWT tokens
# Paste the full PEM-encoded public key here (keep newlines as \n)
MS1_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nYOUR_MS1_PUBLIC_KEY_HERE\n-----END PUBLIC KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nYOUR_MS1_PUBLIC_KEY_HERE\n-----END PUBLIC KEY-----"
JWT_ALGORITHM=RS256
MS1_PUBLIC_KEY_URL=http://localhost:3001/api/auth/public-key

# ─── Internal API security ────────────────────────────────────────────────────
# Shared secret for service-to-service internal calls (MS3 → MS2). REQUIRED with no fallback.
INTERNAL_API_KEY=your_secure_random_internal_api_key_here

# ─── RabbitMQ ─────────────────────────────────────────────────────────────────
RABBITMQ_URL=amqp://forsa_user:forsa_password@localhost:5672
RABBITMQ_EXCHANGE=forsa.events

# ─── Consul ───────────────────────────────────────────────────────────────────
CONSUL_HOST=localhost
CONSUL_PORT=8500

# ─── File uploads ─────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=5
# Public URL base for serving uploaded images (adjust per environment)
MEDIA_BASE_URL=http://localhost:3002/media

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=debug

# ─── Rate limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
