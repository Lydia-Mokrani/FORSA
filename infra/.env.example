# ==============================================================================
# FORSA (WAMS) — Variables d'Environnement de l'Infrastructure & Microservices
# ==============================================================================
# ATTENTION : Ce fichier ne contient QUE des exemples et des placeholders.
# Aucun secret ou clé privée ne doit JAMAIS être commité dans Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Hôte Réseau Inter-Serveurs
# ------------------------------------------------------------------------------
# SERVICE_ADDRESS doit être l'adresse IP de la machine hôte accessible par les
# autres conteneurs et serveurs (ex: IP LAN 192.168.1.50 ou IP privée VPC 10.0.0.11).
# NE JAMAIS METTRE "localhost" OU "127.0.0.1" (injoignable entre nœuds distincts).
SERVICE_ADDRESS=10.0.0.11

# ------------------------------------------------------------------------------
# 2. Service Discovery (Consul)
# ------------------------------------------------------------------------------
CONSUL_HOST=10.0.0.10
CONSUL_PORT=8500
CONSUL_UI_PORT=8500

# ------------------------------------------------------------------------------
# 3. Message Broker (RabbitMQ)
# ------------------------------------------------------------------------------
# Credentials du compte applicatif (aucun compte guest par défaut en production)
RABBITMQ_USER=forsa_user
RABBITMQ_PASSWORD=forsa_secret_password_change_in_prod
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_URL=amqp://forsa_user:forsa_secret_password_change_in_prod@10.0.0.10:5672
EVENT_BUS_DRIVER=rabbitmq
RABBITMQ_MAX_RETRIES=3
RABBITMQ_RETRY_DELAY_MS=1000
RABBITMQ_RECONNECT_INITIAL_MS=1000
RABBITMQ_RECONNECT_MAX_MS=30000

# ------------------------------------------------------------------------------
# 4. Reverse Proxy & Dynamic Load Balancer (Traefik v3)
# ------------------------------------------------------------------------------
TRAEFIK_HTTP_PORT=80
TRAEFIK_DASHBOARD_PORT=8080
# Paramètres du middleware rateLimit pour /api/auth/telegram/start via Consul tags
TRAEFIK_START_RATE_LIMIT_AVERAGE=10
TRAEFIK_START_RATE_LIMIT_BURST=20

# ------------------------------------------------------------------------------
# 5. Base de Données PostgreSQL (Neon / Instance Dédiée)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://forsa_user:forsa_secret_ms1@localhost:5432/neondb_lot1_test?schema=public

# ------------------------------------------------------------------------------
# 6. Instances MS1 (Multi-Instances WAMS)
# ------------------------------------------------------------------------------
MS1_1_PORT=3001
MS1_1_INSTANCE_ID=ms1-accounts-1
MS1_2_PORT=3002
MS1_2_INSTANCE_ID=ms1-accounts-2

# ------------------------------------------------------------------------------
# 7. Clés Cryptographiques JWT RS256
# ------------------------------------------------------------------------------
JWT_KEY_ID=forsa-ms1-auth-v1
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
INTERNAL_API_KEY=0860c84a8ea7aaca109f98b5b30ce65a262d67425aad0f474290c3f3e86822f9

# ------------------------------------------------------------------------------
# 8. Bot Telegram Officiel (@forsa_auth_bot) & MS5 Notifications
# ------------------------------------------------------------------------------
# Le bot est hébergé en singleton poller dans MS5 (Lot 5B-2)
MS5_PORT=3005
MS5_INSTANCE_ID=ms5-notifications-1
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_BOT_USERNAME=forsa_auth_bot
OTP_TTL_SECONDS=300

# ------------------------------------------------------------------------------
# 9. Géocodage Nominatim (OpenStreetMap)
# ------------------------------------------------------------------------------
NOMINATIM_URL=https://nominatim.openstreetmap.org/search
GEOCODER_USER_AGENT=forsa-prod-bot/1.0 (contact@forsa.dz)
GEOCODER_MIN_INTERVAL_MS=1000
GEOCODER_QUEUE_MAX=20
GEOCODER_USER_LIMIT_PER_MIN=10

# ------------------------------------------------------------------------------
# 10. Rate Limiting Métier & Sécurité Anti-Spam
# ------------------------------------------------------------------------------
RATE_LIMIT_START_MAX=3
