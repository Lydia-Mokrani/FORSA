# ─── FORSA Root Environment Configuration ────────────────────────────────────

# ─── MS2 — Catalogue & Search ────────────────────────────────────────────────
NODE_ENV=development
PORT=3002
SERVICE_NAME=ms2-catalogue
SERVICE_ADDRESS=localhost

# MS2 Database
DATABASE_URL=postgresql://ms2_user:ms2_password@localhost:5433/ms2_catalogue

# MS1 Authentication / RS256 Verification
MS1_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nYOUR_MS1_PUBLIC_KEY_HERE\n-----END PUBLIC KEY-----"
MS1_PUBLIC_KEY_URL=http://localhost:3001/api/auth/public-key

# Internal Service Communication
INTERNAL_API_KEY=your_secure_random_internal_api_key_here

# RabbitMQ (configured to match shared infra docker-compose.infra.yml)
RABBITMQ_URL=amqp://forsa_user:forsa_password@localhost:5672
RABBITMQ_EXCHANGE=forsa.events

# Consul Service Discovery
CONSUL_HOST=localhost
CONSUL_PORT=8500

# File Uploads & Media
UPLOAD_DIR=./uploads
MEDIA_BASE_URL=http://localhost:3002/media

# Logging & Security
LOG_LEVEL=debug
CORS_ORIGIN=*
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
