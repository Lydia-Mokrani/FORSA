# ─── FORSA Root Environment Configuration ────────────────────────────────────

# ─── MS2 — Catalogue & Search Service ─────────────────────────────────────────
NODE_ENV=development
PORT=3002
HOST=0.0.0.0
SERVICE_NAME=ms2-catalogue
SERVICE_ADDRESS=localhost
MS2_PUBLISH_PORT=3002

# ─── MS2 Database ─────────────────────────────────────────────────────────────
POSTGRES_DB=ms2_catalogue
POSTGRES_USER=ms2_user
POSTGRES_PASSWORD=ms2_password
DATABASE_URL=postgresql://ms2_user:ms2_password@localhost:5433/ms2_catalogue

# ─── MS1 Authentication / RS256 Verification (Items E, F, G, O) ───────────────
# In production, MS1_PUBLIC_KEY_URL is the primary source of truth (via Traefik gateway http://<S0>/api/auth/public-key)
# Static PEM can be supplied as a bootstrap fallback
MS1_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nYOUR_MS1_PUBLIC_KEY_HERE\n-----END PUBLIC KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nYOUR_MS1_PUBLIC_KEY_HERE\n-----END PUBLIC KEY-----"
MS1_PUBLIC_KEY_URL=http://localhost:3001/api/auth/public-key
JWT_ISSUER=forsa-ms1-accounts
KEY_REFRESH_COOLDOWN_MS=60000

# ─── Internal Service Communication (Item O.4) ────────────────────────────────
# Shared secret for service-to-service internal calls (e.g. MS3 -> MS2).
# Required with no fallback; must be >= 32 characters in production.
INTERNAL_API_KEY=your_secure_random_internal_api_key_here_min_32_chars

# ─── RabbitMQ Message Broker ──────────────────────────────────────────────────
# Matches shared infrastructure in infra/docker-compose.infra.yml
RABBITMQ_URL=amqp://forsa_user:forsa_password@localhost:5672
RABBITMQ_EXCHANGE=forsa.events

# ─── Consul Service Discovery & Health Checks (Items P, N) ────────────────────
CONSUL_HOST=localhost
CONSUL_PORT=8500

# ─── File Uploads & Media Storage (Item S) ────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=5
# In production, MEDIA_BASE_URL must be an absolute public URL and must NOT contain localhost
MEDIA_BASE_URL=http://localhost:3002/media

# ─── Security & Reverse Proxy (Items V, O) ────────────────────────────────────
LOG_LEVEL=debug
# In production, CORS_ORIGIN must be explicit comma-separated origins (not wildcard *)
CORS_ORIGIN=*
TRUST_PROXY=1
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
