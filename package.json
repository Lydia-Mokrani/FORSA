{
  "name": "forsa-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Plateforme web solidaire anti-gaspillage alimentaire (WAMS - ING4 GL UMBB)",
  "workspaces": [
    "packages/*",
    "services/*",
    "frontend"
  ],
  "scripts": {
    "dev:infra": "docker compose -f infra/docker-compose.infra.yml up -d",
    "dev:ms1": "npm run dev --workspace=services/ms1-accounts",
    "dev:front": "npm run dev --workspace=frontend",
    "build:common": "npm run build --workspace=packages/common",
    "prisma:ms1": "npm run prisma:generate --workspace=services/ms1-accounts"
  },
  "keywords": [
    "microservices",
    "anti-waste",
    "rabbitmq",
    "consul",
    "traefik",
    "express",
    "prisma",
    "react"
  ],
  "author": "Équipe FORSA (Hambli Hiba, Mokrani May Lydia, Rebahi Doua, Rafes Maroua, Khoumeri Asma)",
  "license": "ISC"
}
